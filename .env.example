# Local source-build Compose example only.
# Production uses /opt/aioj/env/app.env and deploy/env/production.env.example.
# Copy to .env and replace every placeholder. Never commit the result.

COMPOSE_PROJECT_NAME=aioj-local
COMPOSE_PROFILES=core,app,judge

MYSQL_DATABASE=ai_oj_next
MYSQL_USER=aioj
MYSQL_PASSWORD=replace-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-local-root-password
REDIS_PASSWORD=replace-local-redis-password
RABBITMQ_DEFAULT_USER=aioj
RABBITMQ_DEFAULT_PASS=replace-local-rabbit-password

JWT_ISSUER=aioj
JWT_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Four independent production credentials, one for each direction (T2.1).
AIOJ_INTERNAL_TOKEN_AI_TO_PROBLEM=replace-with-distinct-ai-to-problem-token
AIOJ_INTERNAL_TOKEN_AI_TO_PROBLEM_NEXT=
AIOJ_INTERNAL_TOKEN_JUDGE_TO_PROBLEM=replace-with-distinct-judge-to-problem-token
AIOJ_INTERNAL_TOKEN_JUDGE_TO_PROBLEM_NEXT=
AIOJ_INTERNAL_TOKEN_PROBLEM_TO_AI=replace-with-distinct-problem-to-ai-token
AIOJ_INTERNAL_TOKEN_PROBLEM_TO_AI_NEXT=
AIOJ_INTERNAL_TOKEN_PROBLEM_TO_JUDGE=replace-with-distinct-problem-to-judge-token
AIOJ_INTERNAL_TOKEN_PROBLEM_TO_JUDGE_NEXT=
SANDBOX_TOKEN=replace-with-a-distinct-random-token
# Agent tools' sandbox and executor (compose profile "agent"): two more distinct tokens.
AGENT_SANDBOX_TOKEN=replace-with-a-distinct-random-token
AGENT_EXECUTOR_INTERNAL_TOKEN=replace-with-a-distinct-random-token
AGENT_EXECUTOR_INTERNAL_TOKEN_NEXT=
# agent-executor memory caps in KB; a request above them is rejected (plan T1.10).
AGENT_EXECUTOR_MAX_MEMORY_LIMIT_KB=262144
AGENT_EXECUTOR_MAX_COMPILE_MEMORY_LIMIT_KB=393216

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
AI_LEGACY_MEMORY_MIGRATION_MODE=off

AUTH_FLYWAY_ENABLED=true
PROBLEM_FLYWAY_ENABLED=false
AI_FLYWAY_ENABLED=false

JUDGE_PREFETCH=1
JUDGE_CONCURRENCY=1
JUDGE_MAX_CONCURRENCY=1

VITE_API_BASE_URL=/api
GATEWAY_PORT=8101
WEB_USER_PORT=5175
WEB_ADMIN_PORT=5176
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
SPRINGDOC_ENABLED=false
